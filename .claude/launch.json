{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "demo"
      ],
      "port": 3000
    },
    {
      "name": "demo-3001",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "process.env.DEMO='1';process.env.PORT='3001';require('./server.js')"
      ],
      "port": 3001
    },
    {
      "name": "demo-3002",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "process.env.DEMO='1';process.env.PORT='3002';require('./server.js')"
      ],
      "port": 3002
    },
    {
      "name": "demo-3003-noauth",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "process.env.DEMO='1';process.env.PORT='3003';process.env.AUTH_USERNAME='';require('./server.js')"
      ],
      "port": 3003
    },
    {
      "name": "live",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "port": 3000
    }
  ]
}
