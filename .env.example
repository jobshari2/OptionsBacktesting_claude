# Copy this file to .env and fill in your Upstox app details
# (create an app at https://account.upstox.com/developer/apps).
# The Redirect URL in the Upstox app must exactly match UPSTOX_REDIRECT_URI.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3000/callback

# Optional: paste an access token directly to skip the login button.
UPSTOX_ACCESS_TOKEN=

PORT=3000
# How often to fetch the REST option chain when the WebSocket tick feed is down (milliseconds)
POLL_MS=1500
# Strikes either side of ATM streamed over the WebSocket tick feed (calls + puts)
FEED_STRIKES=15

# ---- Spike signals & recording (all optional; defaults shown) ----
# Strike spike: a strike's last-minute volume is >= SPIKE_RATIO x its normal per-minute volume
# (normal = average over the previous 15 min) and at least SPIKE_MIN_QTY units traded that minute.
SPIKE_RATIO=3
SPIKE_MIN_QTY=25000
# Broad surge: >= BROAD_PCT % of strikes near ATM trade >= BROAD_RATIO x normal volume at the same time.
BROAD_RATIO=2
BROAD_PCT=60
# Nifty rise / fall (separate signals): moves >= SPOT_FAST_PTS within 20 s or >= SPOT_MOVE_PTS within 1 minute.
SPOT_FAST_PTS=15
SPOT_MOVE_PTS=25
# Premium move: a CE or PE near ATM rises OR falls >= PRICE_SPIKE_PCT % within 1 minute (ignoring options below PRICE_MIN_LTP rupees).
# Reported separately per side and direction (CE ▲, CE ▼, PE ▲, PE ▼).
PRICE_SPIKE_PCT=10
PRICE_MIN_LTP=5
# CE + PE rising: on >= BOTH_RISE_PAIRS of the 5 strikes around ATM, the call and the put are both up >= BOTH_RISE_PCT % in 1 minute.
BOTH_RISE_PCT=3
BOTH_RISE_PAIRS=3
# Minutes of history needed before volume signals start, strikes either side of ATM to watch,
# minutes saved before each spike, the max minutes saved after the last spike, and minutes before
# the same signal can fire again.
BASELINE_MIN=5
SIGNAL_STRIKES=10
CAPTURE_BEFORE_MIN=5
CAPTURE_AFTER_MIN=5
SPIKE_COOLDOWN_MIN=5
# A recording stops early once it is at least CAPTURE_MIN_AFTER_SEC past the last spike and no signal
# condition (volume or price) has been true for CAPTURE_CALM_SEC seconds, i.e. things have cooled off.
CAPTURE_MIN_AFTER_SEC=60
CAPTURE_CALM_SEC=30

# ---- Volume Flow predictions (Flow screen) ----
# What counts as bullish vs bearish flow:
#   aggressor = CE bought + PE sold vs PE bought + CE sold, from bid/ask on the tick feed (falls back to premium)
#   premium   = each leg's volume counted by which way its own premium moved
#   volume    = raw CE volume vs PE volume (the original rule)
FLOW_MODE=aggressor
# Predict UP when bullish flow is >= (50 + FLOW_IMBALANCE*50)% of the flow near ATM in the last minute (DOWN for bearish),
# held for FLOW_HOLD_SEC seconds, with at least FLOW_MIN_QTY traded in that minute.
FLOW_IMBALANCE=0.2
FLOW_HOLD_SEC=10
FLOW_MIN_QTY=50000
# HIT = Nifty moves FLOW_REACT_PTS the predicted way before moving that much the other way (MISS);
# FLAT = neither within FLOW_HORIZON_MIN minutes.
FLOW_REACT_PTS=8
FLOW_HORIZON_MIN=3

# Strikes either side of ATM saved in the all-day market tape (events/<date>/tape-*.jsonl.gz) used for replays.
TAPE_STRIKES=15

# ---- Market Pulse ----
# Strikes either side of ATM used for the OI build-up read, and the window it is measured over (minutes).
PULSE_STRIKES=5
PULSE_OI_MIN=15

# Optional: write recordings (events, tapes, predictions, pulse) to another folder instead of ./events
# EVENTS_DIR=D:/market-data

# ---- Zerodha Kite (Live › Feeds screen: Upstox vs Kite ticks) ----
# Kite Connect app (developers.kite.trade; streaming needs the paid data add-on). Set the app's Redirect URL to
# http://localhost:3000/kite/callback, then use "Login with Kite" on the Feeds screen.
KITE_API_KEY=
KITE_API_SECRET=
# Optional: an access token for today (needs KITE_API_KEY), instead of logging in.
KITE_ACCESS_TOKEN=
# Optional, unofficial: the enctoken of a Kite web login (kite.zerodha.com) and your user ID. The screen's
# bookmarklet or token box does the same without editing this file.
KITE_ENCTOKEN=
KITE_USER_ID=
# Live orders (Feeds screen, LIVE switch): real orders on your Kite account. They are sent only with a Kite Connect
# login unless this is 1 (the enctoken web session is unofficial).
KITE_ORDERS_ENCTOKEN=
# Optional market_protection sent with MARKET orders (Kite Connect; e.g. -1 = Kite's automatic protection). Leave
# empty unless Kite rejects market orders without it.
KITE_MARKET_PROTECTION=

# ---- Order Book screen ----
# Strikes either side of ATM shown on the Order Book screen
BOOK_STRIKES=10

# ---- Order flow (Chain screen) ----
# Recorded days before today read for the chart's order flow panes (each is read once from its tape and cached)
# ORDERFLOW_DAYS=10

# ---- Backtester ----
# Where downloaded historical candles are cached (default ./bt-cache). Saved strategies live in ./bt-data.
# BT_CACHE_DIR=D:/market-data/bt-cache

# ---- Strategy Builder: online adjustment research (optional) ----
# Anthropic API key used by "Research online" on the Builder screen (Claude + web search).
ANTHROPIC_API_KEY=
