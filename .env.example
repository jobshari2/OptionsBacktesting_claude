# Copy this file to .env and fill in your Upstox app details
# (create an app at https://account.upstox.com/developer/apps).
# The Redirect URL in the Upstox app must exactly match UPSTOX_REDIRECT_URI.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3000/callback

# Optional: paste an access token directly to skip the login button.
UPSTOX_ACCESS_TOKEN=

PORT=3000
# How often to fetch the REST option chain when the WebSocket tick feed is down (milliseconds)
POLL_MS=1500
# Strikes either side of ATM streamed over the WebSocket tick feed (calls + puts)
FEED_STRIKES=15

# ---- Spike signals & recording (all optional; defaults shown) ----
# Strike spike: a strike's last-minute volume is >= SPIKE_RATIO x its normal per-minute volume
# (normal = average over the previous 15 min) and at least SPIKE_MIN_QTY units traded that minute.
SPIKE_RATIO=3
SPIKE_MIN_QTY=25000
# Broad surge: >= BROAD_PCT % of strikes near ATM trade >= BROAD_RATIO x normal volume at the same time.
BROAD_RATIO=2
BROAD_PCT=60
# Nifty rise / fall (separate signals): moves >= SPOT_FAST_PTS within 20 s or >= SPOT_MOVE_PTS within 1 minute.
SPOT_FAST_PTS=15
SPOT_MOVE_PTS=25
# Premium move: a CE or PE near ATM rises OR falls >= PRICE_SPIKE_PCT % within 1 minute (ignoring options below PRICE_MIN_LTP rupees).
# Reported separately per side and direction (CE ▲, CE ▼, PE ▲, PE ▼).
PRICE_SPIKE_PCT=10
PRICE_MIN_LTP=5
# CE + PE rising: on >= BOTH_RISE_PAIRS of the 5 strikes around ATM, the call and the put are both up >= BOTH_RISE_PCT % in 1 minute.
BOTH_RISE_PCT=3
BOTH_RISE_PAIRS=3
# Minutes of history needed before volume signals start, strikes either side of ATM to watch,
# minutes saved before each spike, the max minutes saved after the last spike, and minutes before
# the same signal can fire again.
BASELINE_MIN=5
SIGNAL_STRIKES=10
CAPTURE_BEFORE_MIN=5
CAPTURE_AFTER_MIN=5
SPIKE_COOLDOWN_MIN=5
# A recording stops early once it is at least CAPTURE_MIN_AFTER_SEC past the last spike and no signal
# condition (volume or price) has been true for CAPTURE_CALM_SEC seconds, i.e. things have cooled off.
CAPTURE_MIN_AFTER_SEC=60
CAPTURE_CALM_SEC=30

# Strikes either side of ATM saved in the all-day market tape (events/<date>/tape-*.jsonl.gz).
TAPE_STRIKES=15

# Optional: write recordings (events, tapes) to another folder instead of ./events
# EVENTS_DIR=D:/market-data

# ---- Backtester ----
# Where downloaded historical candles are cached (default ./bt-cache). Saved strategies live in ./bt-data.
# BT_CACHE_DIR=D:/market-data/bt-cache

# ---- Strategy Builder: online adjustment research (optional) ----
# Anthropic API key used by "Research online" in the Builder tab (Claude + web search).
ANTHROPIC_API_KEY=
