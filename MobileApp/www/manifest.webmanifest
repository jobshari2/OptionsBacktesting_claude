{
  "id": "./",
  "name": "Nifty Options Mobile",
  "short_name": "Nifty Options",
  "description": "Nifty options on your phone: live chain, collars, payoff builder and paper positions, straight from Upstox.",
  "start_url": "./#market",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b1120",
  "theme_color": "#0f172a",
  "categories": ["finance"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Option chain", "url": "./#chain", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Positions", "url": "./#positions", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
